# Copy to `.env.local` and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> Data API / API Keys
#
# Both values are safe to expose in the browser bundle. The anon key only ever
# grants what the row-level security policies in supabase/schema.sql allow,
# which is "the signed-in user's own rows and nothing else".
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
