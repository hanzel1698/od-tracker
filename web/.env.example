# Copy to .env.local for local development. Never commit the real file.
# Supabase dashboard -> Project Settings -> API Keys
# The publishable (anon) key is meant for the browser; RLS limits it to your own rows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
