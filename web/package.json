    "papaparse": "5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.63.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "22.18.6",
    "@types/papaparse": "5.3.16",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
